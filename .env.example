# ==========================================
# SABARISAN TRANSPORT - ENVIRONMENT TEMPLATE (.env.example)
# Fill in your actual production values in your local .env or Vercel Settings
# ==========================================

# 1. Environment & URLs
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_API_URL=https://your-domain.vercel.app/api

# 2. Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 3. Security & JWT Session
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# 4. Super Admin Credentials (Database Seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# 5. SMTP Mail Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Your Business <your_email@example.com>"
ADMIN_NOTIFICATION_EMAIL=your_email@example.com

# 6. Business Profile & Support Details
BUSINESS_NAME="Sabarisan Transport"
BUSINESS_ADDRESS="Near Bus Stand, Bhavani Main Road, Erode, Tamil Nadu 638004"
OWNER_EMAIL=your_email@example.com
OWNER_PHONE="+919876543210"
OWNER_WHATSAPP="919876543210"

# 7. Google Maps API (Optional)
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
