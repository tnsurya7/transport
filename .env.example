# 1. Application Settings
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-transport-app.vercel.app
NEXT_PUBLIC_API_URL=https://your-transport-app.vercel.app/api

# 2. Database Configuration (Neon PostgreSQL for Vercel Deployment)
# Get connection string from https://console.neon.tech
# Pooled connection string (for app runtime / serverless functions):
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (for Prisma CLI migrations & db push):
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. JWT Authentication Security (Generate a random 32+ character key)
JWT_SECRET="sabarisan_transport_jwt_secret_key_erode_tamilnadu_2026_super_secure"
JWT_EXPIRES_IN="7d"

# 4. Super Admin Credentials (Database Seed)
ADMIN_EMAIL="sabarisan5070@gmail.com"
ADMIN_PASSWORD="sabari5070"

# 5. SMTP Mail Server Configuration
# For Gmail: Use 16-digit App Password from Google Account > Security > App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="sabarisan5070@gmail.com"
SMTP_PASS="your_16_digit_app_password"
SMTP_FROM="Sabarisan Transport <sabarisan5070@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="sabarisan5070@gmail.com"

# 6. Business Profile & Customer Support Details
BUSINESS_NAME="Sabarisan Transport"
BUSINESS_ADDRESS="Near Bus Stand, Bhavani Main Road, Erode, Tamil Nadu 638004"
OWNER_EMAIL="sabarisan5070@gmail.com"
